# ── Security (REQUIRED — generate with: openssl rand -base64 48) ──────────────
JWT_SECRET=secret
WORKER_SECRET=secret

# ── Domain ────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=frontend
VITE_ALLOWED_HOSTS=host

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=db
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# ── Ports (internal; the reverse proxy handles external HTTPS) ────────────────
POSTGRES_PORT=5432
BACKEND_PORT=5002
FRONTEND_PORT=3000

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL=5
WORKER_LOG_LEVEL=INFO
WORKER_AUTO_FALLBACK=false
AUTO_DIARIZATION_ASSIGN=true

# Optional: speaker diarization via pyannote
HUGGING_FACE_HUB_TOKEN=hf_token
AUTO_DIARIZATION_ASSIGN=2